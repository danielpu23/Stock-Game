# Production Environment Variables for Stock Game Backend
# Copy this file to .env and fill in the actual values

# Database Configuration (AWS RDS PostgreSQL)
DATABASE_URL=jdbc:postgresql://your-rds-endpoint.rds.amazonaws.com:5432/stock_game
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-strong-database-password

# JWT Configuration
JWT_SECRET=your-very-secure-jwt-secret-generate-with-openssl-rand-base64-32
JWT_EXPIRATION=86400000

# Stock API Configuration
STOCK_API_KEY=cu7id19r01qkucct2r5gcu7id19r01qkucct2r60
STOCK_API_URL=https://finnhub.io/api/v1

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Spring Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080