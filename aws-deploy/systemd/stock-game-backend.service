[Unit]
Description=Stock Game Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/stock-game/backend
Environment="SPRING_PROFILES_ACTIVE=prod"
EnvironmentFile=/var/www/stock-game/backend/.env
ExecStart=/usr/bin/java -jar target/stock-game-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-game-backend

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/stock-game/backend

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target