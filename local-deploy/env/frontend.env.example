# Local Development Environment Variables for Stock Game Frontend
# Copy this file to frontend/.env and fill in the actual values

# API Configuration
# For local development, use localhost
# For Cloudflare Tunnel, use your tunnel URL when tunnel is running
VITE_API_URL=http://localhost:8080

# For Cloudflare Tunnel (uncomment and update when tunnel is running):
# VITE_API_URL=https://your-tunnel-url.pages.dev